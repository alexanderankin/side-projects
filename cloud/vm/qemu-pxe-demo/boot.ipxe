#!ipxe

# dhcp
# chain --autofree tftp://${next-server}/boot.ipxe

#dhcp
chain --autofree tftp://${next-server}/arch.ipxe

:menu
menu Welcome
item
item --gap --    ------------------------- Operating systems ------------------------------
#item hello-world Boot example Hello World OS
item ubuntu      Boot Ubuntu
item ubuntu-mi   Install Ubuntu w/Mini-ISO
item --gap --    ------------------------------ Utilities ---------------------------------
item shell       Enter iPXE shell
item reboot      Reboot
item
item exit        Exit (boot local disk)

choose --default ubuntu-mi --timeout 5000 target && goto ${target}

#:hello-world
#echo "hello world"
#exit
:ubuntu
goto boot-ubuntu

:ubuntu-mi
chain /resolute-mini-iso-amd64.iso iso raw

:shell
shell
set menu-timeout 0
goto menu

:reboot
reboot

:exit
exit

:boot-ubuntu
# kernel tftp://${next-server}/vmlinuz console=ttyS0 # initial attempt, but not seeing console
# kernel tftp://${next-server}/vmlinuz
kernel tftp://${next-server}/resolute-server-cloudimg-${deb_arch}-vmlinuz-generic
initrd tftp://${next-server}/resolute-server-cloudimg-${deb_arch}-initrd-generic
boot
