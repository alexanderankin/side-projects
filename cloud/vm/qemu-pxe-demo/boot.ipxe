#!ipxe

# dhcp
# chain --autofree tftp://${next-server}/boot.ipxe

#dhcp
chain --autofree tftp://${next-server}/arch.ipxe

:menu
menu Welcome
item
item --gap --    ------------------------- Operating systems ------------------------------
#item hello-world Boot example Hello World OS
item ubuntu      Deploy/boot Ubuntu cloud image
item ubuntu-iso  Install Ubuntu w/ISO
item --gap --    ------------------------------ Utilities ---------------------------------
item shell       Enter iPXE shell
item reboot      Reboot
item
item exit        Exit (boot local disk)

set default-choice ubuntu
choose --default ${default-choice} --timeout 5000 target && goto ${target}

#:hello-world
#echo "hello world"
#exit
:ubuntu
chain --autofree tftp://${next-server}/image-version.ipxe
kernel tftp://${next-server}/resolute-server-cloudimg-${deb_arch}-vmlinuz-generic initrd=resolute-initrd root=/dev/vda1 rootfstype=ext4 rw rd.neednet=0 deploy-url=http://${next-server}:8000/resolute-server-cloudimg-${deb_arch}.raw deploy-version=${deploy-version} console=tty0 console=ttyS0,115200n8
initrd --name resolute-initrd tftp://${next-server}/resolute-server-cloudimg-${deb_arch}-initrd-generic
initrd tftp://${next-server}/deploy-overlay.cpio.gz
boot || goto failed

:ubuntu-iso
#chain /resolute-mini-iso-amd64.iso iso raw
#boot

#kernel tftp://${next-server}/memdisk
#initrd tftp://${next-server}/ubuntu-26.04-live-server-amd64.iso
#imgargs memdisk iso raw live-media-path=/casper/
#boot

kernel tftp://${next-server}/installer-vmlinuz initrd=installer-initrd ip=dhcp url=http://${next-server}:8000/ubuntu-26.04-live-server-amd64.iso autoinstall cloud-config-url=/dev/null ds=nocloud-net;s=http://${next-server}:8000/autoinstall/ console=ttyS0,115200n8 ---
initrd --name installer-initrd tftp://${next-server}/installer-initrd
boot || goto failed

:failed
echo Ubuntu installer boot failed
prompt Press any key to return to the menu
goto menu

:shell
shell
set menu-timeout 0
goto menu

:reboot
reboot

:exit
exit
