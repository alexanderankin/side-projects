#cloud-config
autoinstall:
  version: 1
  interactive-sections: []
  locale: en_US.UTF-8
  keyboard:
    layout: us
  refresh-installer:
    update: false
  source:
    id: ubuntu-desktop
    search_drivers: false
  identity:
    hostname: autoinstalled-ubuntu
    username: ubuntu
    # Demo password: ubuntu
    password: '$6$qemu-demo$.zRBsXSmsJH.F64fxshwfg0Wt33sIWjrOnij8TeNlb//a8hNYw1Rlf6e61Z9O6gTwn4rvH.HUXdELvyPsUH7s1'
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - cloud-init
  late-commands:
    - curtin in-target -- cloud-init clean --logs --machine-id --seed
    - curtin in-target -- rm -f /etc/cloud/cloud-init.disabled
  storage:
    layout:
      name: direct
  # Finish the template before its first normal boot, ready for offline capture.
  shutdown: poweroff
